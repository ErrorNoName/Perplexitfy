# Perplexify CLI local environment
# Copy this file to `.env` and fill the values.
#
# Required:
# Get this value from a logged-in perplexity.ai session:
# DevTools > Application > Cookies > https://www.perplexity.ai
PPLX_COOKIE=

# Optional:
PPLX_MODEL=sonar
PPLX_DAILY_LIMIT=50

# Local HTTP bridge defaults:
PERPLEXIFY_HOST=127.0.0.1
PERPLEXIFY_PORT=8787
